<<
/Type /StructElem
/S /H4
/P 146 0 R
/T (CREATE VIEW V_REPORTE_ACADEMICO AS SELECT     a.id_alumno AS Legajo,     CONCAT\(a.apellido, ', ', a.nombre\) AS Alumno,     m.nombre_materia AS Materia,     c.nota AS Calificacion,     c.condicion AS Estado FROM alumnos a JOIN inscripciones i     ON a.id_alumno = i.id_alumno JOIN materias m     ON i.id_materia = m.id_materia JOIN calificaciones c     ON i.id_inscripcion = c.id_inscripcion;)
/E (CREATE VIEW V_REPORTE_ACADEMICO AS SELECT     a.id_alumno AS Legajo,     CONCAT\(a.apellido, ', ', a.nombre\) AS Alumno,     m.nombre_materia AS Materia,     c.nota AS Calificacion,     c.condicion AS Estado FROM alumnos a JOIN inscripciones i     ON a.id_alumno = i.id_alumno JOIN materias m     ON i.id_materia = m.id_materia JOIN calificaciones c     ON i.id_inscripcion = c.id_inscripcion;)
/Pg 18 0 R
/K [0]
>>
endobj
