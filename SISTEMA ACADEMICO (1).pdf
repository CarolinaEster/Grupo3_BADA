/Title (CREATE VIEW V_REPORTE_ACADEMICO AS SELECT     a.id_alumno AS Legajo,     CONCAT\(a.apellido, ', ', a.nombre\) AS Alumno,     m.nombre_materia AS Materia,     c.nota AS Calificacion,     c.condicion AS Estado FROM alumnos a JOIN inscripciones i     ON a.id_alumno = i.id_alumno JOIN materias m     ON i.id_materia = m.id_materia JOIN calificaciones c     ON i.id_inscripcion = c.id_inscripcion;)
/Dest [18 0 R /Fit]
/Parent 1073 0 R
/Next 1134 0 R
>>
endobj
